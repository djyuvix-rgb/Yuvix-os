# ─── Core ────────────────────────────────────────────────────────────────────
# Local default is SQLite: zero infrastructure. To move to Postgres, change the
# datasource provider in prisma/schema.prisma to "postgresql" and set this to a
# postgres:// URL — the schema itself is provider-agnostic.
DATABASE_URL="file:./yuvix.db"

# Where YUVIX OS stores your actual files (audio, artwork, contracts, exports).
# Defaults to ./workspace. Keep this OUT of version control.
YUVIX_WORKSPACE_DIR="./workspace"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ─── Agent model ─────────────────────────────────────────────────────────────
# Required for the agent to think. Without it the app still runs (panels, data,
# reviews, audio analysis) but chat returns a clear "not configured" error.
ANTHROPIC_API_KEY=""
YUVIX_MODEL="claude-opus-5"
YUVIX_FAST_MODEL="claude-sonnet-5"
# Hard ceiling on tool-calling iterations per agent run.
YUVIX_MAX_STEPS="24"

# ─── Web research (optional, pick one) ───────────────────────────────────────
# Without one of these, research tools report "not configured" and the agent
# tells you so instead of inventing sources.
BRAVE_SEARCH_API_KEY=""
TAVILY_API_KEY=""
SERPER_API_KEY=""

# ─── Embeddings for semantic memory (optional) ───────────────────────────────
# Provider: "local" (default, deterministic hashed n-gram vectors, no network)
# or "voyage" (needs VOYAGE_API_KEY) for higher-quality retrieval.
YUVIX_EMBEDDING_PROVIDER="local"
VOYAGE_API_KEY=""

# ─── Platform integrations (all optional) ────────────────────────────────────
# Each is inert until its variables are set. The Integrations panel shows which
# are connected and links to setup instructions. Nothing is ever simulated.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
YOUTUBE_API_KEY=""
SOUNDCLOUD_CLIENT_ID=""
